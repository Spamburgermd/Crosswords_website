# Development secret values. Copy this file to ".env" and edit the values.
# Never commit the real .env file to source control.
SECRET_KEY=dev-change-me
DATABASE_URL=sqlite:///./croswords.db

# Allow UNSAFE client-reported colors (do NOT enable for public/ranked)
CLIENT_TRUSTED_FEEDBACK=false

# Quieter local runs (less logging, no extra telemetry)
LOCAL_ONLY_MODE=false
