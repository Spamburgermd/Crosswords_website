{
    "extends":  "expo/tsconfig.base",
    "compilerOptions":  {
                            "strict":  true,
                            "noImplicitAny":  true,
                            "jsx":  "react-jsx",
                            "baseUrl":  ".",
                            "paths":  {
                                          "@src/*":  [
                                                         "src/*"
                                                     ],
                                          "@screens/*":  [
                                                             "src/screens/*"
                                                         ],
                                          "@components/*":  [
                                                                "src/components/*"
                                                            ],
                                          "@stores/*":  [
                                                            "src/stores/*"
                                                        ],
                                          "@ui/*":  [
                                                         "src/ui/*"
                                                     ],
                                          "@lib/*":  [
                                                         "src/lib/*"
                                                     ],
                                          "@schemas/*":  [
                                                             "src/types/*"
                                                         ],
                                          "@assets/*":  [
                                                            "assets/*"
                                                        ],
                                          "@hooks/*":  [
                                                           "src/hooks/*"
                                                       ]
                                      },
                            "types":  [
                                          "react",
                                          "react-native",
                                          "node"
                                      ]
                        },
    "include":  [
                    "App.tsx",
                    "app.tsx",
                    "src/**/*.ts",
                    "src/**/*.tsx"
                ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.test.tsx",
      "src/**/__tests__/**"
                ]
}
