# Expo reads variables prefixed with EXPO_PUBLIC_. Copy this file to .env and edit values.
#
# Server endpoint used by src/lib/api.ts.
# Real phone on same Wi-Fi: use your computer LAN IP (example: http://10.0.0.104:8000)
# Android emulator: use http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_ENABLE_CROSSROADS_STYLES=false
EXPO_PUBLIC_PREVIEW_SCREEN=

# Master switch for all server-backed functions (auth, lobby, guesses, friends).
# true  = normal online behavior
# false = force local-only behavior and block all network API calls
EXPO_PUBLIC_ENABLE_SERVER_FUNCTIONS=true

# Legacy compatibility flag. Keep false unless you explicitly want the old offline mode behavior.
EXPO_PUBLIC_OFFLINE_LOCAL_ONLY=false

# Dev-only helper: show raw target words in the Alphabet side panel.
# Keep false for release builds submitted to stores.
EXPO_PUBLIC_SHOW_DEV_TARGET_WORDS=true
